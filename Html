<style>
:root{
--bg: #ffffff;
--ink: #0e2238;
--body: #47586d;
--blue: #2b6fee;
--green: #4f9a1f;
--green-bright: #6bbf2f;
--card: #f4f7fb;
--card-border: #e3e9f2;
--navy-band: #0e2238;
--navy-band-2: #163257;
--max: 1160px;
}

*{ box-sizing: border-box; }
html{ scroll-behavior: smooth; }
body{
margin:0;
font-family:'Inter', sans-serif;
color: var(--body);
background: var(--bg);
-webkit-font-smoothing: antialiased;
}
h1,h2,h3{
font-family:'Space Grotesk', sans-serif;
color: var(--ink);
margin:0;
letter-spacing: -0.01em;
}
a{ color: inherit; text-decoration:none; }
img{ max-width:100%; display:block; }
.wrap{ max-width: var(--max); margin:0 auto; padding: 0 32px; }

:focus-visible{
outline: 2px solid var(--blue);
outline-offset: 3px;
}

/* ---------- header ---------- */
header{
position: sticky; top:0; z-index: 20;
background: rgba(255,255,255,0.92);
backdrop-filter: blur(8px);
border-bottom: 1px solid var(--card-border);
}
.header-inner{
display:flex; align-items:center; justify-content:space-between;
padding: 18px 0;
}
.logo{ display:flex; align-items:center; gap:10px; }
.logo-mark{
width:34px; height:34px; border-radius:9px;
background: linear-gradient(135deg, var(--green-bright), var(--blue));
display:flex; align-items:center; justify-content:center;
color:#fff; font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:16px;
flex-shrink:0;
}
.logo-text{ line-height:1.15; }
.logo-text .name{ font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:17px; color:var(--ink); }
.logo-text .name span{ color: var(--green); }
.logo-text .tag{ font-size:11px; color:#8595a8; letter-spacing:0.04em; }

nav ul{ display:flex; gap:34px; list-style:none; margin:0; padding:0; }
nav a{
font-size:15px; font-weight:500; color: var(--body);
padding-bottom:4px; border-bottom: 2px solid transparent;
transition: color .15s ease, border-color .15s ease;
}
nav a:hover{ color: var(--ink); }
nav a.active{ color: var(--ink); border-bottom-color: var(--green-bright); }

.socials{ display:flex; gap:10px; }
.socials a{
width:34px; height:34px; border-radius:50%;
border:1px solid var(--card-border);
display:flex; align-items:center; justify-content:center;
color: var(--ink); transition: background .15s ease, color .15s ease, border-color .15s ease;
}
.socials a:hover{ background: var(--ink); border-color: var(--ink); color:#fff; }
.socials svg{ width:15px; height:15px; }

.nav-toggle{ display:none; background:none; border:none; cursor:pointer; padding:6px; }
.nav-toggle span{ display:block; width:22px; height:2px; background: var(--ink); margin:4px 0; }

/* ---------- hero ---------- */
.hero{ padding: 76px 0 88px; }
.hero-grid{
display:grid; grid-template-columns: 1.05fr 0.85fr; gap:64px; align-items:center;
}
.eyebrow{
display:flex; align-items:center; gap:10px;
font-size:13px; font-weight:600; letter-spacing:0.06em; color: var(--green);
margin-bottom:18px;
}
.eyebrow::before{ content:""; width:26px; height:2px; background: var(--green-bright); display:inline-block; }
.hero h1{
font-size: clamp(38px, 5vw, 54px); font-weight:700; line-height:1.06;
}
.hero h1 .accent{ color: var(--green); }
.hero p.lede{
margin-top:22px; font-size:17px; line-height:1.65; max-width: 46ch; color: var(--body);
}
.hero-cta{ display:flex; gap:16px; margin-top:34px; flex-wrap:wrap; }

.btn{
display:inline-flex; align-items:center; gap:9px;
padding: 13px 26px; border-radius: 10px;
font-weight:600; font-size:15px; font-family:'Inter',sans-serif;
transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
border: none; cursor:pointer;
}
.btn-primary{
background: var(--green-bright); color:#0e2238;
box-shadow: 0 10px 24px -10px rgba(79,154,31,0.55);
}
.btn-primary:hover{ transform: translateY(-2px); background:#7ccb3c; }
.btn-ghost{
background: transparent; color: var(--ink); border: 1px solid var(--card-border);
}
.btn-ghost:hover{ border-color: var(--ink); }

.hero-panel{
position:relative;
background: var(--card);
border: 1px solid var(--card-border);
border-radius: 22px;
padding: 34px;
min-height: 340px;
display:flex; flex-direction:column; justify-content:space-between;
overflow:hidden;
}
.hero-panel::before{
content:"";
position:absolute; top:-60px; right:-60px;
width:220px; height:220px; border-radius:50%;
background: radial-gradient(circle, rgba(43,111,238,0.16), transparent 70%);
}
.hero-panel::after{
content:"";
position:absolute; bottom:-80px; left:-40px;
width:220px; height:220px; border-radius:50%;
background: radial-gradient(circle, rgba(107,191,47,0.18), transparent 70%);
}
.panel-dots{ display:flex; gap:7px; position:relative; z-index:1; }
.panel-dots span{ width:9px; height:9px; border-radius:50%; background: var(--card-border); }
.panel-dots span:nth-child(1){ background: var(--blue); }
.panel-dots span:nth-child(2){ background: var(--green-bright); }

.panel-quote{
position:relative; z-index:1;
font-family:'Caveat', cursive; font-size: 40px; line-height:1.15;
color: var(--ink); font-weight:600; margin-top:20px;
}
.panel-underline{ width:120px; height:3px; margin-top:10px; background: var(--green-bright); border-radius:2px; position:relative; z-index:1; }

.panel-stats{
position:relative; z-index:1;
display:flex; gap:28px; margin-top:26px; padding-top:22px;
border-top: 1px solid var(--card-border);
}
.panel-stats div strong{ display:block; font-family:'Space Grotesk',sans-serif; font-size:22px; color: var(--ink); }
.panel-stats div span{ font-size:12.5px; color:#8595a8; }

/* ---------- services ---------- */
.services{ padding: 20px 0 96px; }
.section-head{ max-width: 560px; margin-bottom: 46px; }
.section-head h2{ font-size: clamp(28px, 3.4vw, 36px); font-weight:700; margin-top:14px; }
.section-head p{ margin-top:14px; font-size:16px; line-height:1.6; }

.grid{
display:grid; grid-template-columns: repeat(3, 1fr); gap:22px;
}
.card{
background:#fff;
border: 1px solid var(--card-border);
border-radius: 16px;
padding: 30px 26px;
transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
}
.card:hover{
border-color: transparent;
box-shadow: 0 18px 36px -22px rgba(14,34,56,0.28);
transform: translateY(-3px);
}
.icon{
width:48px; height:48px; border-radius:12px;
display:flex; align-items:center; justify-content:center;
margin-bottom:20px;
}
.icon svg{ width:22px; height:22px; }
.icon.blue{ background:#e8f0ff; color: var(--blue); }
.icon.green{ background:#eaf6df; color: var(--green); }
.icon.navy{ background:#e7ecf3; color: var(--ink); }
.icon.teal{ background:#e2f6f2; color:#0f9d84; }
.icon.amber{ background:#fdefdd; color:#c47a12; }
.icon.rose{ background:#fbe6ea; color:#c93356; }

.card h3{ font-size:19px; font-weight:600; margin-bottom:10px; }
.card p{ font-size:14.5px; line-height:1.6; margin:0 0 18px; }
.card-link{
font-size:14px; font-weight:600; color: var(--ink);
display:inline-flex; align-items:center; gap:6px;
}
.card-link svg{ width:14px; height:14px; transition: transform .15s ease; }
.card:hover .card-link svg{ transform: translateX(3px); }

/* ---------- CTA band ---------- */
.cta-band{
background: linear-gradient(120deg, var(--navy-band), var(--navy-band-2));
padding: 68px 0;
position:relative; overflow:hidden;
}
.cta-band::before{
content:"";
position:absolute; top:-100px; right:8%;
width:320px; height:320px; border-radius:50%;
background: radial-gradient(circle, rgba(107,191,47,0.20), transparent 70%);
}
.cta-grid{
display:flex; justify-content:space-between; align-items:center; gap:40px; position:relative; z-index:1;
}
.cta-band .eyebrow{ color: var(--green-bright); }
.cta-band h2{ color:#fff; font-size: clamp(26px,3.2vw,34px); font-weight:700; margin-top:12px; }
.cta-band p{ color:#b7c4d6; margin-top:12px; font-size:15.5px; max-width:42ch; line-height:1.6; }
.cta-band .btn-primary{ margin-top:26px; }

/* ---------- footer ---------- */
footer{ padding: 46px 0 30px; border-top: 1px solid var(--card-border); }
.footer-top{
display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:24px;
padding-bottom: 28px; margin-bottom: 22px; border-bottom: 1px solid var(--card-border);
}
footer nav ul{ gap:26px; }
.footer-bottom{
display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px;
font-size:13px; color:#8595a8;
}

@media (max-width: 880px){
.hero-grid{ grid-template-columns: 1fr; }
.hero-panel{ order:-1; }
.grid{ grid-template-columns: repeat(2, 1fr); }
nav{ display:none; }
.nav-toggle{ display:block; }
.cta-grid{ flex-direction:column; align-items:flex-start; text-align:left; }
}
@media (max-width: 560px){
.wrap{ padding:0 20px; }
.grid{ grid-template-columns: 1fr; }
.hero{ padding: 52px 0 60px; }
.socials{ display:none; }
}

@media (prefers-reduced-motion: reduce){
*{ transition:none !important; scroll-behavior:auto !important; }
}
</style>
</head>
